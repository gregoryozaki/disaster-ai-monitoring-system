 Ocorrencia -> Validacao [label="1:N"];
 Ocorrencia -> Historico [label="1:N"];
 Ocorrencia -> Solicitacao [label="1:N"];
 Ocorrencia -> Complemento [label="1:N"];
 Ocorrencia -> Integridade [label="1:N"];
 Solicitacao -> Complemento [label="1:N"];
 Complemento -> Evidencia [label="1:N opcional"];
