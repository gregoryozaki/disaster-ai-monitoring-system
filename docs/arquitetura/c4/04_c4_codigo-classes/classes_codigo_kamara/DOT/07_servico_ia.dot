digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.8", splines=polyline, fontname="Arial", fontsize=20, labelloc="t", label="Diagrama de Classes — Serviço de Inteligência Artificial"];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#333333", arrowsize=0.8];
subgraph cluster_0 { label="API de Inferência"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"InferenceAPI" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>InferenceAPI</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;FastAPI controller&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- orchestrator: InferenceOrchestrator</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ preAnalise(req): InferenceResponse<BR ALIGN="LEFT"/>+ previsao(req): PredictionResponse<BR ALIGN="LEFT"/>+ explicar(req): ExplanationResponse</TD></TR></TABLE>>];
"InferenceRequest" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#DCEAF7" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>InferenceRequest</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;DTO&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ occurrenceId: string<BR ALIGN="LEFT"/>+ imageRef: string?<BR ALIGN="LEFT"/>+ text: string?</TD></TR></TABLE>>];
"InferenceResponse" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#DCEAF7" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>InferenceResponse</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;DTO&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ category: string?<BR ALIGN="LEFT"/>+ cobrade: string?<BR ALIGN="LEFT"/>+ confidence: float?<BR ALIGN="LEFT"/>+ simpleExplanation: string?<BR ALIGN="LEFT"/>+ ambiguous: boolean<BR ALIGN="LEFT"/>+ modelVersion: string?</TD></TR></TABLE>>];
"PredictionRequest" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#DCEAF7" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>PredictionRequest</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;DTO&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ region: string<BR ALIGN="LEFT"/>+ disasterType: string<BR ALIGN="LEFT"/>+ horizonHours: int<BR ALIGN="LEFT"/>+ features: map</TD></TR></TABLE>>];
"PredictionResponse" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#DCEAF7" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>PredictionResponse</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;DTO&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ riskLevel: string<BR ALIGN="LEFT"/>+ probability: float?<BR ALIGN="LEFT"/>+ trend: string?<BR ALIGN="LEFT"/>+ modelVersion: string<BR ALIGN="LEFT"/>+ experimental: boolean</TD></TR></TABLE>>];
"ExplanationResponse" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#DCEAF7" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>ExplanationResponse</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;DTO&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ method: string<BR ALIGN="LEFT"/>+ payload: map<BR ALIGN="LEFT"/>+ modelVersion: string</TD></TR></TABLE>>];
}
subgraph cluster_1 { label="Orquestração e Modelos"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"InferenceOrchestrator" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>InferenceOrchestrator</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- visual: IClassifier<BR ALIGN="LEFT"/>- textual: IClassifier<BR ALIGN="LEFT"/>- predictor: IRiskPredictor<BR ALIGN="LEFT"/>- explainers: IExplainer[]<BR ALIGN="LEFT"/>- models: ModelManager<BR ALIGN="LEFT"/>- builder: ResponseBuilder</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ preAnalisar(req)<BR ALIGN="LEFT"/>+ prever(req)<BR ALIGN="LEFT"/>+ explicar(req)</TD></TR></TABLE>>];
"ModelManager" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ModelManager</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- activeVersions: map</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getModel(tipo, versao?)<BR ALIGN="LEFT"/>+ reload(config)<BR ALIGN="LEFT"/>+ versionInfo(tipo)</TD></TR></TABLE>>];
"ResponseBuilder" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ResponseBuilder</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;builder&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ classification(result, meta): InferenceResponse<BR ALIGN="LEFT"/>+ prediction(result, meta): PredictionResponse</TD></TR></TABLE>>];
"IClassifier" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IClassifier</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ classify(input, model): ClassificationResult</TD></TR></TABLE>>];
"IRiskPredictor" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IRiskPredictor</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ predict(input, model): RiskResult</TD></TR></TABLE>>];
"IExplainer" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IExplainer</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ explain(input, result, model): Explanation</TD></TR></TABLE>>];
}
subgraph cluster_2 { label="Implementações ML / XAI"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"VisualClassifier" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>VisualClassifier</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;component&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- preprocessador: ImagePreprocessor</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ classify(input, model): ClassificationResult</TD></TR></TABLE>>];
"TextClassifier" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>TextClassifier</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;component&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- preprocessador: TextPreprocessor</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ classify(input, model): ClassificationResult</TD></TR></TABLE>>];
"RiskPredictor" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>RiskPredictor</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;component&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ predict(input, model): RiskResult</TD></TR></TABLE>>];
"GradCAMExplainer" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>GradCAMExplainer</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;component&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ explain(input,result,model): Explanation</TD></TR></TABLE>>];
"SHAPExplainer" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>SHAPExplainer</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;component&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ explain(input,result,model): Explanation</TD></TR></TABLE>>];
"ImagePreprocessor" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#DCEAF7" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>ImagePreprocessor</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;component&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ prepare(bytes): Tensor</TD></TR></TABLE>>];
"TextPreprocessor" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#DCEAF7" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>TextPreprocessor</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;component&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ prepare(text): Tokens</TD></TR></TABLE>>];
}
"InferenceAPI" -> "InferenceOrchestrator" [style=dashed, arrowhead=vee, label="delega"];
"InferenceAPI" -> "InferenceRequest" [style=dashed, arrowhead=vee, label="recebe"];
"InferenceAPI" -> "PredictionRequest" [style=dashed, arrowhead=vee, label="recebe"];
"InferenceAPI" -> "InferenceResponse" [style=dashed, arrowhead=vee, label="retorna"];
"InferenceAPI" -> "PredictionResponse" [style=dashed, arrowhead=vee, label="retorna"];
"InferenceAPI" -> "ExplanationResponse" [style=dashed, arrowhead=vee, label="retorna"];
"InferenceOrchestrator" -> "IClassifier" [style=dashed, arrowhead=vee, label="classifica"];
"InferenceOrchestrator" -> "IRiskPredictor" [style=dashed, arrowhead=vee, label="prevê"];
"InferenceOrchestrator" -> "IExplainer" [style=dashed, arrowhead=vee, label="explica"];
"InferenceOrchestrator" -> "ModelManager" [style=dashed, arrowhead=vee, label="obtém modelos/parâmetros"];
"InferenceOrchestrator" -> "ResponseBuilder" [style=dashed, arrowhead=vee, label="padroniza resposta"];
"VisualClassifier" -> "IClassifier" [style=dashed, arrowhead=empty, label=""];
"TextClassifier" -> "IClassifier" [style=dashed, arrowhead=empty, label=""];
"RiskPredictor" -> "IRiskPredictor" [style=dashed, arrowhead=empty, label=""];
"GradCAMExplainer" -> "IExplainer" [style=dashed, arrowhead=empty, label=""];
"SHAPExplainer" -> "IExplainer" [style=dashed, arrowhead=empty, label=""];
"VisualClassifier" -> "ImagePreprocessor" [dir=both, arrowtail=diamond, arrowhead=vee, label="usa"];
"TextClassifier" -> "TextPreprocessor" [dir=both, arrowtail=diamond, arrowhead=vee, label="usa"];
}