digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.8", splines=polyline, fontname="Arial", fontsize=20, labelloc="t", label="Diagrama de Classes — Backend: Analytics, Previsão, Exportação e Administração"];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#333333", arrowsize=0.8];
subgraph cluster_0 { label="Controllers / API HTTP"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"AnalyticsController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AnalyticsController</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;controller&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- service: AnalyticsService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ indicadores(filtros)</TD></TR></TABLE>>];
"PredictionController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PredictionController</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;controller&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- service: PredictionService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ prever(parametros)</TD></TR></TABLE>>];
"ExportController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ExportController</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;controller&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- service: ExportService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ exportar(parametros)<BR ALIGN="LEFT"/>+ status(id)</TD></TR></TABLE>>];
"AdminController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AdminController</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;controller&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- service: AdminService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ gestores(cmd)<BR ALIGN="LEFT"/>+ categorias(cmd)<BR ALIGN="LEFT"/>+ limiares(cmd)<BR ALIGN="LEFT"/>+ auditoria(filtros)</TD></TR></TABLE>>];
}
subgraph cluster_1 { label="Analytics, Previsão, Exportação, Administração e Auditoria"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"AnalyticsService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AnalyticsService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- query: IAnalyticsRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ indicadores(filtros)<BR ALIGN="LEFT"/>+ distribuicoes(filtros)</TD></TR></TABLE>>];
"PredictionService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PredictionService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- data: IEnvironmentalDataGateway<BR ALIGN="LEFT"/>- ia: IAClient<BR ALIGN="LEFT"/>- repo: IPredictionRepository<BR ALIGN="LEFT"/>- provenance: ProvenanceService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ prever(regiao, tipo, horizonte)</TD></TR></TABLE>>];
"ExportService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ExportService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- query: IAnalyticsRepository<BR ALIGN="LEFT"/>- exportRepo: IExportRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ criarExportacao(usuarioId, formato, filtros)<BR ALIGN="LEFT"/>+ processar(id)</TD></TR></TABLE>>];
"AdminService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AdminService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- config: IConfigRepository<BR ALIGN="LEFT"/>- audit: AuditService<BR ALIGN="LEFT"/>- ia: IAClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ configurarCategoria(cmd)<BR ALIGN="LEFT"/>+ configurarLimiar(cmd)<BR ALIGN="LEFT"/>+ gerenciarGestor(cmd)</TD></TR></TABLE>>];
"AuditService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AuditService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repo: IAuditRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registrar(acao, usuarioId, entidade)<BR ALIGN="LEFT"/>+ consultar(filtros)</TD></TR></TABLE>>];
"ProvenanceService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ProvenanceService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repo: IProvenanceRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registrarInferencia(dados)<BR ALIGN="LEFT"/>+ registrarFonte(dados)</TD></TR></TABLE>>];
"IAClient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IAClient</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;gateway&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- baseUrl: string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ prever(payload): PrevisaoDTO<BR ALIGN="LEFT"/>+ atualizarParametros(payload)</TD></TR></TABLE>>];
}
subgraph cluster_2 { label="Repositórios / Gateways"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"IEnvironmentalDataGateway" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IEnvironmentalDataGateway</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ obter(regiao, periodo): DadosAmbientais</TD></TR></TABLE>>];
"IAnalyticsRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IAnalyticsRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregar(filtros)<BR ALIGN="LEFT"/>+ listarParaExportacao(filtros)</TD></TR></TABLE>>];
"IPredictionRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IPredictionRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ salvar(previsao)<BR ALIGN="LEFT"/>+ listar(filtros)</TD></TR></TABLE>>];
"IConfigRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IConfigRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ salvarCategoria(categoria)<BR ALIGN="LEFT"/>+ salvarLimiar(limiar)<BR ALIGN="LEFT"/>+ obterConfiguracaoAtiva(tipo)</TD></TR></TABLE>>];
"IExportRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IExportRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ criar(job)<BR ALIGN="LEFT"/>+ atualizar(job)<BR ALIGN="LEFT"/>+ obter(id)</TD></TR></TABLE>>];
"IAuditRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IAuditRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registrar(log)<BR ALIGN="LEFT"/>+ consultar(filtros)</TD></TR></TABLE>>];
"IProvenanceRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IProvenanceRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registrar(proveniencia)</TD></TR></TABLE>>];
"EnvironmentalDataClient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>EnvironmentalDataClient</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;gateway&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ obter(regiao, periodo)</TD></TR></TABLE>>];
"PrismaAnalyticsRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PrismaAnalyticsRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;repository&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregar(filtros)<BR ALIGN="LEFT"/>+ listarParaExportacao(filtros)</TD></TR></TABLE>>];
"PrismaPredictionRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PrismaPredictionRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;repository&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ salvar(previsao)<BR ALIGN="LEFT"/>+ listar(filtros)</TD></TR></TABLE>>];
"PrismaConfigRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PrismaConfigRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;repository&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ salvarCategoria(categoria)<BR ALIGN="LEFT"/>+ salvarLimiar(limiar)<BR ALIGN="LEFT"/>+ obterConfiguracaoAtiva(tipo)</TD></TR></TABLE>>];
"PrismaExportRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PrismaExportRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;repository&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ criar(job)<BR ALIGN="LEFT"/>+ atualizar(job)<BR ALIGN="LEFT"/>+ obter(id)</TD></TR></TABLE>>];
"PrismaProvenanceRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PrismaProvenanceRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;repository&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registrar(proveniencia)</TD></TR></TABLE>>];
}
"AnalyticsController" -> "AnalyticsService" [style=dashed, arrowhead=vee, label="usa"];
"PredictionController" -> "PredictionService" [style=dashed, arrowhead=vee, label="usa"];
"ExportController" -> "ExportService" [style=dashed, arrowhead=vee, label="usa"];
"AdminController" -> "AdminService" [style=dashed, arrowhead=vee, label="usa"];
"AdminController" -> "AuditService" [style=dashed, arrowhead=vee, label="consulta auditoria"];
"AnalyticsService" -> "IAnalyticsRepository" [style=dashed, arrowhead=vee, label="agrega dados"];
"PredictionService" -> "IEnvironmentalDataGateway" [style=dashed, arrowhead=vee, label="dados ambientais"];
"PredictionService" -> "IAClient" [style=dashed, arrowhead=vee, label="inferência"];
"PredictionService" -> "IPredictionRepository" [style=dashed, arrowhead=vee, label="salva previsão"];
"PredictionService" -> "ProvenanceService" [style=dashed, arrowhead=vee, label="rastreia"];
"ExportService" -> "IAnalyticsRepository" [style=dashed, arrowhead=vee, label="consulta dados"];
"ExportService" -> "IExportRepository" [style=dashed, arrowhead=vee, label="job exportação"];
"AdminService" -> "IConfigRepository" [style=dashed, arrowhead=vee, label="configura"];
"AdminService" -> "AuditService" [style=dashed, arrowhead=vee, label="audita"];
"AdminService" -> "IAClient" [style=dashed, arrowhead=vee, label="publica parâmetros quando aplicável"];
"AuditService" -> "IAuditRepository" [style=dashed, arrowhead=vee, label="persiste logs"];
"ProvenanceService" -> "IProvenanceRepository" [style=dashed, arrowhead=vee, label="persiste proveniência"];
"EnvironmentalDataClient" -> "IEnvironmentalDataGateway" [style=dashed, arrowhead=empty, label=""];
"PrismaAnalyticsRepository" -> "IAnalyticsRepository" [style=dashed, arrowhead=empty, label=""];
"PrismaPredictionRepository" -> "IPredictionRepository" [style=dashed, arrowhead=empty, label=""];
"PrismaConfigRepository" -> "IConfigRepository" [style=dashed, arrowhead=empty, label=""];
"PrismaExportRepository" -> "IExportRepository" [style=dashed, arrowhead=empty, label=""];
"PrismaProvenanceRepository" -> "IProvenanceRepository" [style=dashed, arrowhead=empty, label=""];
}