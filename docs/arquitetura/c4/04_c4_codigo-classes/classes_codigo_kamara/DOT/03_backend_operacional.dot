digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.8", splines=polyline, fontname="Arial", fontsize=20, labelloc="t", label="Diagrama de Classes — Backend Operacional"];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#333333", arrowsize=0.8];
subgraph cluster_0 { label="API HTTP / Roteador"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"ApiRouter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ApiRouter</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;controller&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registrarRotas()</TD></TR></TABLE>>];
"AuthController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AuthController</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;controller&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- service: AuthService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ login(req)<BR ALIGN="LEFT"/>+ ativarConta(req)<BR ALIGN="LEFT"/>+ recuperarSenha(req)</TD></TR></TABLE>>];
"OccurrenceController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>OccurrenceController</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;controller&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- service: OccurrenceService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ criar(req)<BR ALIGN="LEFT"/>+ obter(id)<BR ALIGN="LEFT"/>+ historico(usuarioId)</TD></TR></TABLE>>];
"SyncController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>SyncController</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;controller&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- service: OfflineSyncService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ sincronizar(req)</TD></TR></TABLE>>];
"ValidationController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ValidationController</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;controller&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- service: ValidationService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar(id, comando)<BR ALIGN="LEFT"/>+ solicitarComplemento(id, dados)</TD></TR></TABLE>>];
"PublicQueryController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PublicQueryController</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;controller&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- service: PublicQueryService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ listar(filtros)<BR ALIGN="LEFT"/>+ detalhe(id)</TD></TR></TABLE>>];
}
subgraph cluster_1 { label="Serviços de aplicação"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"AuthService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AuthService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- users: IUserRepository<BR ALIGN="LEFT"/>- notifications: NotificationService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ autenticar(email, senha)<BR ALIGN="LEFT"/>+ ativarConta(codigo, senha)<BR ALIGN="LEFT"/>+ solicitarRecuperacao(email)</TD></TR></TABLE>>];
"OccurrenceService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>OccurrenceService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- occurrences: IOccurrenceRepository<BR ALIGN="LEFT"/>- ia: IAClient<BR ALIGN="LEFT"/>- audit: IAuditRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ criar(dto, cidadaoId)<BR ALIGN="LEFT"/>+ solicitarPreAnalise(id)<BR ALIGN="LEFT"/>+ obter(id)</TD></TR></TABLE>>];
"OfflineSyncService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>OfflineSyncService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- occurrenceService: OccurrenceService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ sincronizar(dtoLocal)<BR ALIGN="LEFT"/>+ reconciliarId(localId, remotoId)</TD></TR></TABLE>>];
"ValidationService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ValidationService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- occurrences: IOccurrenceRepository<BR ALIGN="LEFT"/>- validations: IValidationRepository<BR ALIGN="LEFT"/>- audit: IAuditRepository<BR ALIGN="LEFT"/>- notifications: NotificationService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ confirmar(id, gestorId)<BR ALIGN="LEFT"/>+ corrigir(id, categoriaId, gestorId)<BR ALIGN="LEFT"/>+ rejeitar(id, motivo, gestorId)<BR ALIGN="LEFT"/>+ pedirComplemento(id, mensagem, gestorId)</TD></TR></TABLE>>];
"PublicQueryService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PublicQueryService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- occurrences: IOccurrenceRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ listarConfirmadas(filtros)<BR ALIGN="LEFT"/>+ detalhePublico(id)</TD></TR></TABLE>>];
"NotificationService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>NotificationService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- email: IEmailGateway</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ enviarAtivacao(email, token)<BR ALIGN="LEFT"/>+ enviarRecuperacao(email, token)<BR ALIGN="LEFT"/>+ informarComplemento(usuarioId, ocorrenciaId)</TD></TR></TABLE>>];
"IAClient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IAClient</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;gateway&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- baseUrl: string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ preAnalisar(payload): PreAnaliseDTO<BR ALIGN="LEFT"/>+ prever(payload): PrevisaoDTO</TD></TR></TABLE>>];
}
subgraph cluster_2 { label="Repositórios Prisma / Gateways"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"IUserRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IUserRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ obterPorEmail(email)<BR ALIGN="LEFT"/>+ obterPorId(id)<BR ALIGN="LEFT"/>+ salvar(usuario)</TD></TR></TABLE>>];
"IOccurrenceRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IOccurrenceRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ salvar(ocorrencia)<BR ALIGN="LEFT"/>+ obterPorId(id)<BR ALIGN="LEFT"/>+ listar(filtros)<BR ALIGN="LEFT"/>+ listarConfirmadas(filtros)</TD></TR></TABLE>>];
"IValidationRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IValidationRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ salvar(validacao)<BR ALIGN="LEFT"/>+ listarPorOcorrencia(id)</TD></TR></TABLE>>];
"IAuditRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IAuditRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registrar(evento)</TD></TR></TABLE>>];
"IEmailGateway" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IEmailGateway</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ enviar(destinatario, assunto, corpo)</TD></TR></TABLE>>];
"PrismaUserRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PrismaUserRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;repository&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ obterPorEmail(email)<BR ALIGN="LEFT"/>+ obterPorId(id)<BR ALIGN="LEFT"/>+ salvar(usuario)</TD></TR></TABLE>>];
"PrismaOccurrenceRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PrismaOccurrenceRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;repository&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ salvar(ocorrencia)<BR ALIGN="LEFT"/>+ obterPorId(id)<BR ALIGN="LEFT"/>+ listar(filtros)<BR ALIGN="LEFT"/>+ listarConfirmadas(filtros)</TD></TR></TABLE>>];
"PrismaValidationRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PrismaValidationRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;repository&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ salvar(validacao)<BR ALIGN="LEFT"/>+ listarPorOcorrencia(id)</TD></TR></TABLE>>];
"PrismaAuditRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PrismaAuditRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;repository&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registrar(evento)</TD></TR></TABLE>>];
"EmailGateway" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>EmailGateway</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;gateway&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- provider: MailProvider</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ enviar(destinatario, assunto, corpo)</TD></TR></TABLE>>];
}
"ApiRouter" -> "AuthController" [arrowhead=vee, label="/auth"];
"ApiRouter" -> "OccurrenceController" [arrowhead=vee, label="/ocorrencias"];
"ApiRouter" -> "SyncController" [arrowhead=vee, label="/sync"];
"ApiRouter" -> "ValidationController" [arrowhead=vee, label="/validacoes"];
"ApiRouter" -> "PublicQueryController" [arrowhead=vee, label="/publico"];
"AuthController" -> "AuthService" [style=dashed, arrowhead=vee, label="usa"];
"OccurrenceController" -> "OccurrenceService" [style=dashed, arrowhead=vee, label="usa"];
"SyncController" -> "OfflineSyncService" [style=dashed, arrowhead=vee, label="usa"];
"ValidationController" -> "ValidationService" [style=dashed, arrowhead=vee, label="usa"];
"PublicQueryController" -> "PublicQueryService" [style=dashed, arrowhead=vee, label="usa"];
"AuthService" -> "IUserRepository" [style=dashed, arrowhead=vee, label="persiste usuários"];
"AuthService" -> "NotificationService" [style=dashed, arrowhead=vee, label="notifica conta"];
"OccurrenceService" -> "IOccurrenceRepository" [style=dashed, arrowhead=vee, label="persiste ocorrência"];
"OccurrenceService" -> "IAClient" [style=dashed, arrowhead=vee, label="pré-análise"];
"OccurrenceService" -> "IAuditRepository" [style=dashed, arrowhead=vee, label="rastreabilidade"];
"OfflineSyncService" -> "OccurrenceService" [style=dashed, arrowhead=vee, label="entrega sincronizada"];
"ValidationService" -> "IOccurrenceRepository" [style=dashed, arrowhead=vee, label="atualiza status"];
"ValidationService" -> "IValidationRepository" [style=dashed, arrowhead=vee, label="grava decisão"];
"ValidationService" -> "IAuditRepository" [style=dashed, arrowhead=vee, label="audita"];
"ValidationService" -> "NotificationService" [style=dashed, arrowhead=vee, label="complemento/atualização"];
"PublicQueryService" -> "IOccurrenceRepository" [style=dashed, arrowhead=vee, label="consulta confirmed"];
"NotificationService" -> "IEmailGateway" [style=dashed, arrowhead=vee, label="envia e-mail"];
"PrismaUserRepository" -> "IUserRepository" [style=dashed, arrowhead=empty, label=""];
"PrismaOccurrenceRepository" -> "IOccurrenceRepository" [style=dashed, arrowhead=empty, label=""];
"PrismaValidationRepository" -> "IValidationRepository" [style=dashed, arrowhead=empty, label=""];
"PrismaAuditRepository" -> "IAuditRepository" [style=dashed, arrowhead=empty, label=""];
"EmailGateway" -> "IEmailGateway" [style=dashed, arrowhead=empty, label=""];
}