digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.8", splines=polyline, fontname="Arial", fontsize=20, labelloc="t", label="Diagrama de Classes — Frontend: Dashboard Gestor e Administração"];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#333333", arrowsize=0.8];
subgraph cluster_0 { label="Dashboard Gestor / Administração — React/Next.js"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"LoginPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>LoginPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- session: SessionStore</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ entrar()<BR ALIGN="LEFT"/>+ recuperarSenha()</TD></TR></TABLE>>];
"OperationalMapPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>OperationalMapPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: DashboardApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ carregar(filtros)<BR ALIGN="LEFT"/>+ selecionar(id)</TD></TR></TABLE>>];
"OccurrenceListPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>OccurrenceListPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: DashboardApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ listar(filtros)</TD></TR></TABLE>>];
"OccurrenceDetailPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>OccurrenceDetailPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: DashboardApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ carregar(id)</TD></TR></TABLE>>];
"ValidationPanel" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ValidationPanel</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Component&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: DashboardApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ confirmar()<BR ALIGN="LEFT"/>+ corrigir()<BR ALIGN="LEFT"/>+ rejeitar()<BR ALIGN="LEFT"/>+ solicitarComplemento()</TD></TR></TABLE>>];
"AnalyticsPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AnalyticsPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: DashboardApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ indicadores(filtros)</TD></TR></TABLE>>];
"PredictionPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PredictionPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: DashboardApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ prever(regiao,tipo,horizonte)</TD></TR></TABLE>>];
"ExportPanel" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ExportPanel</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Component&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: DashboardApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ exportarCSV()<BR ALIGN="LEFT"/>+ exportarJSON()</TD></TR></TABLE>>];
"AdminPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AdminPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: DashboardApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ gerenciarGestores()<BR ALIGN="LEFT"/>+ configurarCategorias()<BR ALIGN="LEFT"/>+ configurarLimiares()</TD></TR></TABLE>>];
"AuditPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AuditPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: DashboardApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ consultar(filtros)</TD></TR></TABLE>>];
}
subgraph cluster_1 { label="Estado e acesso HTTP"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"SessionStore" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>SessionStore</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;state store&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- usuario: UsuarioSessao?<BR ALIGN="LEFT"/>- token: string?<BR ALIGN="LEFT"/>- api: DashboardApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ login()<BR ALIGN="LEFT"/>+ logout()<BR ALIGN="LEFT"/>+ pode(permissao)</TD></TR></TABLE>>];
"DashboardApiClient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>DashboardApiClient</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;HTTP client&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- baseUrl: string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ocorrencias(filtros)<BR ALIGN="LEFT"/>+ detalhe(id)<BR ALIGN="LEFT"/>+ validar(id, cmd)<BR ALIGN="LEFT"/>+ indicadores(filtros)<BR ALIGN="LEFT"/>+ prever(params)<BR ALIGN="LEFT"/>+ exportar(params)<BR ALIGN="LEFT"/>+ administrar(cmd)</TD></TR></TABLE>>];
}
"LoginPage" -> "SessionStore" [style=dashed, arrowhead=vee, label="usa"];
"SessionStore" -> "DashboardApiClient" [style=dashed, arrowhead=vee, label="autenticação"];
"OperationalMapPage" -> "DashboardApiClient" [style=dashed, arrowhead=vee, label="mapa/filtros"];
"OccurrenceListPage" -> "DashboardApiClient" [style=dashed, arrowhead=vee, label="lista/filtros"];
"OccurrenceDetailPage" -> "DashboardApiClient" [style=dashed, arrowhead=vee, label="detalhes"];
"OccurrenceDetailPage" -> "ValidationPanel" [arrowhead=vee, label="inclui"];
"ValidationPanel" -> "DashboardApiClient" [style=dashed, arrowhead=vee, label="registra decisão"];
"AnalyticsPage" -> "DashboardApiClient" [style=dashed, arrowhead=vee, label="indicadores"];
"AnalyticsPage" -> "ExportPanel" [arrowhead=vee, label="inclui exportação"];
"ExportPanel" -> "DashboardApiClient" [style=dashed, arrowhead=vee, label="exporta"];
"PredictionPage" -> "DashboardApiClient" [style=dashed, arrowhead=vee, label="previsão"];
"AdminPage" -> "DashboardApiClient" [style=dashed, arrowhead=vee, label="administração"];
"AuditPage" -> "DashboardApiClient" [style=dashed, arrowhead=vee, label="auditoria"];
}