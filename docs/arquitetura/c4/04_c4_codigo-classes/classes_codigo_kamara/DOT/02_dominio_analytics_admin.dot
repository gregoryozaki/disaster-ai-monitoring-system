digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.8", splines=polyline, fontname="Arial", fontsize=20, labelloc="t", label="Diagrama de Classes — Domínio: Previsão, Proveniência, Configuração e Auditoria"];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#333333", arrowsize=0.8];
"UsuarioRef" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#DCEAF7" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>UsuarioRef</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;reference&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- papel: PapelUsuario</TD></TR></TABLE>>];
"CategoriaDesastre" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>CategoriaDesastre</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- codigoCobrade: string<BR ALIGN="LEFT"/>- nome: string<BR ALIGN="LEFT"/>- ativa: boolean</TD></TR></TABLE>>];
"VersaoModelo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>VersaoModelo</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- nomeModelo: string<BR ALIGN="LEFT"/>- versao: string<BR ALIGN="LEFT"/>- algoritmo: string<BR ALIGN="LEFT"/>- parametrosJson: json<BR ALIGN="LEFT"/>- ativo: boolean<BR ALIGN="LEFT"/>- criadoEm: datetime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ativar()<BR ALIGN="LEFT"/>+ desativar()</TD></TR></TABLE>>];
"LimiarConfianca" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>LimiarConfianca</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- categoriaId: UUID<BR ALIGN="LEFT"/>- baixaMax: decimal<BR ALIGN="LEFT"/>- altaMin: decimal<BR ALIGN="LEFT"/>- versao: int<BR ALIGN="LEFT"/>- ativo: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ classificarFaixa(valor): string</TD></TR></TABLE>>];
"FonteDado" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>FonteDado</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- nome: string<BR ALIGN="LEFT"/>- tipo: string<BR ALIGN="LEFT"/>- origem: string<BR ALIGN="LEFT"/>- atualizadoEm: datetime?<BR ALIGN="LEFT"/>- ativa: boolean</TD></TR></TABLE>>];
"PrevisaoRisco" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PrevisaoRisco</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- categoriaId: UUID<BR ALIGN="LEFT"/>- versaoModeloId: UUID<BR ALIGN="LEFT"/>- regiao: string<BR ALIGN="LEFT"/>- horizonteHoras: int<BR ALIGN="LEFT"/>- nivel: NivelRisco<BR ALIGN="LEFT"/>- probabilidade: decimal?<BR ALIGN="LEFT"/>- tendencia: string?<BR ALIGN="LEFT"/>- experimental: boolean<BR ALIGN="LEFT"/>- geradaEm: datetime</TD></TR></TABLE>>];
"NivelRisco" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#FFF3A6" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>NivelRisco</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">BAIXO<BR ALIGN="LEFT"/>MEDIO<BR ALIGN="LEFT"/>ALTO</TD></TR></TABLE>>];
"Proveniencia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Proveniencia</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- tipoArtefato: string<BR ALIGN="LEFT"/>- artefatoId: UUID<BR ALIGN="LEFT"/>- versaoModeloId: UUID?<BR ALIGN="LEFT"/>- fonteDadoId: UUID?<BR ALIGN="LEFT"/>- metadadosJson: json<BR ALIGN="LEFT"/>- registradoEm: datetime</TD></TR></TABLE>>];
"ExportacaoDados" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ExportacaoDados</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- solicitanteId: UUID<BR ALIGN="LEFT"/>- formato: FormatoExportacao<BR ALIGN="LEFT"/>- filtrosJson: json<BR ALIGN="LEFT"/>- status: StatusExportacao<BR ALIGN="LEFT"/>- arquivoRef: string?<BR ALIGN="LEFT"/>- criadoEm: datetime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ concluir(arquivoRef)<BR ALIGN="LEFT"/>+ falhar()</TD></TR></TABLE>>];
"FormatoExportacao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#FFF3A6" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>FormatoExportacao</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CSV<BR ALIGN="LEFT"/>JSON</TD></TR></TABLE>>];
"StatusExportacao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#FFF3A6" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>StatusExportacao</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PENDENTE<BR ALIGN="LEFT"/>PROCESSANDO<BR ALIGN="LEFT"/>CONCLUIDA<BR ALIGN="LEFT"/>FALHA</TD></TR></TABLE>>];
"AuditLog" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AuditLog</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- usuarioId: UUID?<BR ALIGN="LEFT"/>- acao: string<BR ALIGN="LEFT"/>- entidade: string<BR ALIGN="LEFT"/>- entidadeId: UUID?<BR ALIGN="LEFT"/>- detalhesJson: json?<BR ALIGN="LEFT"/>- criadoEm: datetime</TD></TR></TABLE>>];
"CategoriaDesastre" -> "LimiarConfianca" [dir=both, arrowtail=diamond, arrowhead=vee, label="possui", taillabel="1", headlabel="0..*", labeldistance=1.5];
"CategoriaDesastre" -> "PrevisaoRisco" [arrowhead=vee, label="tipo previsto", taillabel="1", headlabel="0..*", labeldistance=1.5];
"VersaoModelo" -> "PrevisaoRisco" [arrowhead=vee, label="gera", taillabel="1", headlabel="0..*", labeldistance=1.5];
"PrevisaoRisco" -> "NivelRisco" [arrowhead=vee, label="nível"];
"VersaoModelo" -> "Proveniencia" [arrowhead=vee, label="referenciada por", taillabel="1", headlabel="0..*", labeldistance=1.5];
"FonteDado" -> "Proveniencia" [arrowhead=vee, label="registrada em", taillabel="1", headlabel="0..*", labeldistance=1.5];
"PrevisaoRisco" -> "Proveniencia" [dir=both, arrowtail=diamond, arrowhead=vee, label="possui proveniência", taillabel="1", headlabel="1..*", labeldistance=1.5];
"UsuarioRef" -> "ExportacaoDados" [arrowhead=vee, label="solicita", taillabel="1", headlabel="0..*", labeldistance=1.5];
"ExportacaoDados" -> "FormatoExportacao" [arrowhead=vee, label="formato"];
"ExportacaoDados" -> "StatusExportacao" [arrowhead=vee, label="status"];
"UsuarioRef" -> "AuditLog" [arrowhead=vee, label="origina", taillabel="1", headlabel="0..*", labeldistance=1.5];
}