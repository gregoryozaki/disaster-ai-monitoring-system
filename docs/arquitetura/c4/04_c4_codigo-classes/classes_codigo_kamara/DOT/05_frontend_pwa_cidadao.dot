digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.8", splines=polyline, fontname="Arial", fontsize=20, labelloc="t", label="Diagrama de Classes — Frontend: PWA Cidadão e Mapa Público"];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#333333", arrowsize=0.8];
subgraph cluster_0 { label="PWA Cidadão / Mapa Público — React/Next.js"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"AuthPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AuthPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- auth: AuthStore</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ entrar()<BR ALIGN="LEFT"/>+ cadastrar()<BR ALIGN="LEFT"/>+ recuperarSenha()</TD></TR></TABLE>>];
"OccurrenceFormPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>OccurrenceFormPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- model: OccurrenceFormModel</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ enviar()</TD></TR></TABLE>>];
"HistoryPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>HistoryPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: CitizenApiClient<BR ALIGN="LEFT"/>- offline: OfflineOccurrenceRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ carregarHistorico()</TD></TR></TABLE>>];
"OccurrenceDetailPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>OccurrenceDetailPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: CitizenApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ carregar(id)<BR ALIGN="LEFT"/>+ complementar(dto)</TD></TR></TABLE>>];
"PublicMapPage" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1F67B1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>PublicMapPage</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;React Page&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: CitizenApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ carregarMapa(filtros)<BR ALIGN="LEFT"/>+ selecionar(id)</TD></TR></TABLE>>];
}
subgraph cluster_1 { label="Estado, serviços e acesso a dados"; color="#777777"; style="rounded,dashed"; fontname="Arial Bold"; fontsize=14;
"AuthStore" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>AuthStore</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;state store&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- usuario: UsuarioSessao?<BR ALIGN="LEFT"/>- token: string?<BR ALIGN="LEFT"/>- api: CitizenApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ login()<BR ALIGN="LEFT"/>+ logout()<BR ALIGN="LEFT"/>+ restoreSession()</TD></TR></TABLE>>];
"OccurrenceFormModel" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>OccurrenceFormModel</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;view model&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- api: CitizenApiClient<BR ALIGN="LEFT"/>- offline: OfflineOccurrenceRepository<BR ALIGN="LEFT"/>- media: MediaCaptureService<BR ALIGN="LEFT"/>- geo: GeolocationService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar()<BR ALIGN="LEFT"/>+ registrar()</TD></TR></TABLE>>];
"MediaCaptureService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>MediaCaptureService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;browser service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ capturarFoto()<BR ALIGN="LEFT"/>+ selecionarVideo()</TD></TR></TABLE>>];
"GeolocationService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>GeolocationService</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;browser service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ obterLocalizacao()<BR ALIGN="LEFT"/>+ usarManual(lat, lon)</TD></TR></TABLE>>];
"CitizenApiClient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>CitizenApiClient</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;HTTP client&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- baseUrl: string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ criarOcorrencia(dto)<BR ALIGN="LEFT"/>+ historico()<BR ALIGN="LEFT"/>+ detalhe(id)<BR ALIGN="LEFT"/>+ listarPublicas(filtros)<BR ALIGN="LEFT"/>+ enviarComplemento(id,dto)</TD></TR></TABLE>>];
"OfflineOccurrenceRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>OfflineOccurrenceRepository</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;repository&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- db: IndexedDBAdapter</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ salvarPendente(dto)<BR ALIGN="LEFT"/>+ listarPendentes()<BR ALIGN="LEFT"/>+ marcarSincronizada(localId, remotoId)</TD></TR></TABLE>>];
"IndexedDBAdapter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#9A93A5" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>IndexedDBAdapter</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;adapter&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dbName: string</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ put(store, value)<BR ALIGN="LEFT"/>+ getAll(store)<BR ALIGN="LEFT"/>+ delete(store, key)</TD></TR></TABLE>>];
"SyncManager" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#35A6D8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>SyncManager</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;service&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- offline: OfflineOccurrenceRepository<BR ALIGN="LEFT"/>- api: CitizenApiClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ sincronizarPendencias()<BR ALIGN="LEFT"/>+ reagendarFalhas()</TD></TR></TABLE>>];
}
"AuthPage" -> "AuthStore" [style=dashed, arrowhead=vee, label="usa"];
"AuthStore" -> "CitizenApiClient" [style=dashed, arrowhead=vee, label="autenticação"];
"OccurrenceFormPage" -> "OccurrenceFormModel" [style=dashed, arrowhead=vee, label="usa"];
"OccurrenceFormModel" -> "MediaCaptureService" [style=dashed, arrowhead=vee, label="captura mídia"];
"OccurrenceFormModel" -> "GeolocationService" [style=dashed, arrowhead=vee, label="localização"];
"OccurrenceFormModel" -> "CitizenApiClient" [style=dashed, arrowhead=vee, label="envia online"];
"OccurrenceFormModel" -> "OfflineOccurrenceRepository" [style=dashed, arrowhead=vee, label="salva offline"];
"OfflineOccurrenceRepository" -> "IndexedDBAdapter" [dir=both, arrowtail=diamond, arrowhead=vee, label="persiste local"];
"SyncManager" -> "OfflineOccurrenceRepository" [style=dashed, arrowhead=vee, label="lê pendências"];
"SyncManager" -> "CitizenApiClient" [style=dashed, arrowhead=vee, label="sincroniza"];
"HistoryPage" -> "CitizenApiClient" [style=dashed, arrowhead=vee, label="consulta remoto"];
"HistoryPage" -> "OfflineOccurrenceRepository" [style=dashed, arrowhead=vee, label="consulta pendentes"];
"OccurrenceDetailPage" -> "CitizenApiClient" [style=dashed, arrowhead=vee, label="detalhes/complemento"];
"PublicMapPage" -> "CitizenApiClient" [style=dashed, arrowhead=vee, label="somente confirmed"];
}