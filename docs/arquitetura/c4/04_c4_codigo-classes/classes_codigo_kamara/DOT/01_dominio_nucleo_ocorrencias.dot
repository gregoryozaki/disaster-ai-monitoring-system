digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.8", splines=polyline, fontname="Arial", fontsize=20, labelloc="t", label="Diagrama de Classes — Domínio: Usuários, Ocorrências e Validação"];
node [shape=plain, fontname="Arial", fontsize=11];
edge [fontname="Arial", fontsize=10, color="#333333", arrowsize=0.8];
"Usuario" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Usuario</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- nome: string?<BR ALIGN="LEFT"/>- email: string<BR ALIGN="LEFT"/>- senhaHash: string<BR ALIGN="LEFT"/>- papel: PapelUsuario<BR ALIGN="LEFT"/>- status: StatusConta<BR ALIGN="LEFT"/>- criadoEm: datetime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ podeAcessar(permissao): boolean</TD></TR></TABLE>>];
"PapelUsuario" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#FFF3A6" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>PapelUsuario</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CIDADAO<BR ALIGN="LEFT"/>GESTOR<BR ALIGN="LEFT"/>ADMINISTRADOR</TD></TR></TABLE>>];
"StatusConta" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#FFF3A6" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>StatusConta</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PENDENTE_ATIVACAO<BR ALIGN="LEFT"/>ATIVA<BR ALIGN="LEFT"/>DESATIVADA</TD></TR></TABLE>>];
"ConviteGestor" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ConviteGestor</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- emailAutorizado: string<BR ALIGN="LEFT"/>- codigoHash: string<BR ALIGN="LEFT"/>- expiraEm: datetime<BR ALIGN="LEFT"/>- usadoEm: datetime?<BR ALIGN="LEFT"/>- criadoPorId: UUID</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ estaValido(): boolean</TD></TR></TABLE>>];
"Ocorrencia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Ocorrencia</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- cidadaoId: UUID<BR ALIGN="LEFT"/>- categoriaFinalId: UUID?<BR ALIGN="LEFT"/>- descricao: string<BR ALIGN="LEFT"/>- latitude: decimal<BR ALIGN="LEFT"/>- longitude: decimal<BR ALIGN="LEFT"/>- urgencia: int<BR ALIGN="LEFT"/>- riscoHumano: boolean<BR ALIGN="LEFT"/>- status: StatusOcorrencia<BR ALIGN="LEFT"/>- dataHora: datetime<BR ALIGN="LEFT"/>- criadoEm: datetime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ alterarStatus(novoStatus)<BR ALIGN="LEFT"/>+ podeSerPublicada(): boolean</TD></TR></TABLE>>];
"StatusOcorrencia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#FFF3A6" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>StatusOcorrencia</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">DRAFT<BR ALIGN="LEFT"/>PENDING_SYNC<BR ALIGN="LEFT"/>UNDER_REVIEW<BR ALIGN="LEFT"/>NEEDS_MORE_INFO<BR ALIGN="LEFT"/>CONFIRMED<BR ALIGN="LEFT"/>REJECTED</TD></TR></TABLE>>];
"EvidenciaMidia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>EvidenciaMidia</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- ocorrenciaId: UUID<BR ALIGN="LEFT"/>- complementoId: UUID?<BR ALIGN="LEFT"/>- tipo: TipoMidia<BR ALIGN="LEFT"/>- referencia: string<BR ALIGN="LEFT"/>- criadoEm: datetime</TD></TR></TABLE>>];
"TipoMidia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#FFF3A6" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>TipoMidia</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FOTO<BR ALIGN="LEFT"/>VIDEO</TD></TR></TABLE>>];
"CategoriaDesastre" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>CategoriaDesastre</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- codigoCobrade: string<BR ALIGN="LEFT"/>- nome: string<BR ALIGN="LEFT"/>- ativa: boolean</TD></TR></TABLE>>];
"ClassificacaoIA" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ClassificacaoIA</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- ocorrenciaId: UUID<BR ALIGN="LEFT"/>- categoriaPrevistaId: UUID?<BR ALIGN="LEFT"/>- confianca: decimal?<BR ALIGN="LEFT"/>- explicacaoSimples: string?<BR ALIGN="LEFT"/>- ambigua: boolean<BR ALIGN="LEFT"/>- versaoModeloId: UUID?<BR ALIGN="LEFT"/>- criadoEm: datetime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ disponivel(): boolean</TD></TR></TABLE>>];
"Validacao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>Validacao</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- ocorrenciaId: UUID<BR ALIGN="LEFT"/>- gestorId: UUID<BR ALIGN="LEFT"/>- decisao: DecisaoValidacao<BR ALIGN="LEFT"/>- categoriaFinalId: UUID?<BR ALIGN="LEFT"/>- observacao: string?<BR ALIGN="LEFT"/>- criadoEm: datetime</TD></TR></TABLE>>];
"DecisaoValidacao" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#FFF3A6" ALIGN="CENTER"><FONT COLOR="#222222" POINT-SIZE="15"><B>DecisaoValidacao</B></FONT><BR/><FONT COLOR="#222222" POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CONFIRMAR<BR ALIGN="LEFT"/>CORRIGIR<BR ALIGN="LEFT"/>REJEITAR<BR ALIGN="LEFT"/>SOLICITAR_COMPLEMENTO</TD></TR></TABLE>>];
"HistoricoStatus" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>HistoricoStatus</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- ocorrenciaId: UUID<BR ALIGN="LEFT"/>- statusAnterior: StatusOcorrencia?<BR ALIGN="LEFT"/>- statusNovo: StatusOcorrencia<BR ALIGN="LEFT"/>- usuarioId: UUID?<BR ALIGN="LEFT"/>- motivo: string?<BR ALIGN="LEFT"/>- criadoEm: datetime</TD></TR></TABLE>>];
"SolicitacaoComplemento" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>SolicitacaoComplemento</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- ocorrenciaId: UUID<BR ALIGN="LEFT"/>- gestorId: UUID<BR ALIGN="LEFT"/>- mensagem: string<BR ALIGN="LEFT"/>- criadaEm: datetime<BR ALIGN="LEFT"/>- respondidaEm: datetime?</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ respondida(): boolean</TD></TR></TABLE>>];
"ComplementoOcorrencia" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#63B8E8" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="15"><B>ComplementoOcorrencia</B></FONT><BR/><FONT COLOR="white" POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: UUID<BR ALIGN="LEFT"/>- solicitacaoId: UUID<BR ALIGN="LEFT"/>- cidadaoId: UUID<BR ALIGN="LEFT"/>- texto: string?<BR ALIGN="LEFT"/>- criadoEm: datetime</TD></TR></TABLE>>];
"Usuario" -> "PapelUsuario" [arrowhead=vee, label="papel"];
"Usuario" -> "StatusConta" [arrowhead=vee, label="status"];
"Usuario" -> "Ocorrencia" [arrowhead=vee, label="registra", taillabel="1", headlabel="0..*", labeldistance=1.5];
"Usuario" -> "Validacao" [arrowhead=vee, label="realiza", taillabel="1", headlabel="0..*", labeldistance=1.5];
"Usuario" -> "ConviteGestor" [arrowhead=vee, label="cria", taillabel="1", headlabel="0..*", labeldistance=1.5];
"Ocorrencia" -> "StatusOcorrencia" [arrowhead=vee, label="status"];
"Ocorrencia" -> "CategoriaDesastre" [arrowhead=vee, label="categoria final", taillabel="0..*", headlabel="0..1", labeldistance=1.5];
"Ocorrencia" -> "EvidenciaMidia" [dir=both, arrowtail=diamond, arrowhead=vee, label="possui", taillabel="1", headlabel="0..*", labeldistance=1.5];
"EvidenciaMidia" -> "TipoMidia" [arrowhead=vee, label="tipo"];
"Ocorrencia" -> "ClassificacaoIA" [dir=both, arrowtail=diamond, arrowhead=vee, label="recebe", taillabel="1", headlabel="0..*", labeldistance=1.5];
"ClassificacaoIA" -> "CategoriaDesastre" [arrowhead=vee, label="prevê", taillabel="0..*", headlabel="0..1", labeldistance=1.5];
"Ocorrencia" -> "Validacao" [dir=both, arrowtail=diamond, arrowhead=vee, label="possui", taillabel="1", headlabel="0..*", labeldistance=1.5];
"Validacao" -> "DecisaoValidacao" [arrowhead=vee, label="decisão"];
"Validacao" -> "CategoriaDesastre" [arrowhead=vee, label="define categoria", taillabel="0..*", headlabel="0..1", labeldistance=1.5];
"Ocorrencia" -> "HistoricoStatus" [dir=both, arrowtail=diamond, arrowhead=vee, label="registra transições", taillabel="1", headlabel="1..*", labeldistance=1.5];
"HistoricoStatus" -> "StatusOcorrencia" [arrowhead=vee, label="novo status"];
"Ocorrencia" -> "SolicitacaoComplemento" [dir=both, arrowtail=diamond, arrowhead=vee, label="pode exigir", taillabel="1", headlabel="0..*", labeldistance=1.5];
"SolicitacaoComplemento" -> "ComplementoOcorrencia" [dir=both, arrowtail=diamond, arrowhead=vee, label="é respondida por", taillabel="1", headlabel="0..1", labeldistance=1.5];
"ComplementoOcorrencia" -> "EvidenciaMidia" [dir=both, arrowtail=odiamond, arrowhead=vee, label="inclui mídia", taillabel="0..1", headlabel="0..*", labeldistance=1.5];
}