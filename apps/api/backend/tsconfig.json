{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "build",

    "types": ["node"],

    "sourceMap": true,

    "strict": true,

    "esModuleInterop": true,
    "verbatimModuleSyntax": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true
  },

  "include": ["src/**/*.ts"],

  "exclude": ["node_modules", "build", "tests"]
}
